# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=syncboard
POSTGRES_PASSWORD=syncboard_dev_password
POSTGRES_DB=syncboard
POSTGRES_PORT=5432

# --- API (apps/api) ---
PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://syncboard:syncboard_dev_password@localhost:5432/syncboard?schema=public
API_CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-long-random-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
REFRESH_COOKIE_NAME=syncboard_refresh

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1