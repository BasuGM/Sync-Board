{
  "name": "syncboard",
  "version": "0.1.0",
  "private": true,
  "description": "SyncBoard — real-time collaborative workspace monorepo",
  "scripts": {
    "dev": "pnpm run --parallel --filter @syncboard/web --filter @syncboard/api dev",
    "build": "pnpm run -r build",
    "lint": "pnpm run -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\" --ignore-path .gitignore",
    "typecheck": "pnpm run -r typecheck",
    "test": "pnpm run -r test",
    "test:e2e": "pnpm --filter @syncboard/web test:e2e",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @syncboard/api prisma:migrate"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "@prisma/client",
      "prisma",
      "@prisma/engines",
      "esbuild",
      "@nestjs/core",
      "msw",
      "argon2"
    ]
  }
}